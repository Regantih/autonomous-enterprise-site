{
  "name": "autonomous-enterprise-site",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing site for The Autonomous Enterprise by Hemanth Reganti",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/build.mjs && git diff --exit-code -- dist lib/knowledge.generated.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler pages dev",
    "db:local": "wrangler d1 execute autonomous-enterprise --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute autonomous-enterprise --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 migrations apply autonomous-enterprise --local",
    "db:migrate:remote": "wrangler d1 migrations apply autonomous-enterprise --remote",
    "deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@types/node": "^22.20.7",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.155.0"
  },
  "engines": {
    "node": ">=20"
  }
}
